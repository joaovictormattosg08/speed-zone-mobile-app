{
  "expo": {
    "name": "SpeedZone",
    "slug": "speed-zone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/speedzone-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.joaovictor.speedzone",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/speedzone-foreground.png",
        "backgroundColor": "#0B0F0D"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorize a SpeedZone a selecionar sua foto de perfil.",
          "cameraPermission": "Autorize a SpeedZone a tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "speedzone",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "368e1138-40a9-4524-bdaf-152522d5f00f"
      }
    }
  }
}
