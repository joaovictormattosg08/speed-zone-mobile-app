{
  "expo": {
    "name": "SpeedZone",
    "slug": "speed-zone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/speedzone-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/speedzone-foreground.png",
        "backgroundColor": "#0B0F0D"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorize a SpeedZone a selecionar sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "speedzone"
  }
}
